<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/radio_selected" />
            <stroke
                android:width="2dp"
                android:color="@color/radio_border_selected" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_checked="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/radio_unselected" />
            <stroke
                android:width="1dp"
                android:color="@color/radio_border_unselected" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>