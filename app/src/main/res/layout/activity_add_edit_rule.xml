<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:layoutDirection="rtl">

        <!-- Header Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:layoutDirection="rtl">

                <TextView
                    android:id="@+id/textTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/create_new_rule"
                    android:textColor="@color/primary_text"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textAlignment="viewStart"
                    android:gravity="start" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/create_rule_subtitle"
                    android:textColor="@color/secondary_text"
                    android:textSize="14sp"
                    android:textAlignment="viewStart"
                    android:gravity="start" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Rule Name Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:layoutDirection="rtl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rule_name_label"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_marginBottom="12dp"
                    android:textAlignment="viewStart"
                    android:gravity="start" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/rule_name_hint"
                    app:boxStrokeColor="@color/accent_color"
                    app:hintTextColor="@color/accent_color"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputRuleName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_text"
                        android:textAlignment="viewStart"
                        android:gravity="start" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Rule Type Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:layoutDirection="rtl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rule_type_label"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_marginBottom="16dp"
                    android:textAlignment="viewStart"
                    android:gravity="start" />

                <RadioGroup
                    android:id="@+id/ruleTypeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layoutDirection="rtl">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radioTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/time_rule"
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:buttonTint="@color/accent_color"
                        android:padding="12dp"
                        android:background="@drawable/radio_button_background"
                        android:layout_marginStart="8dp"
                        android:textAlignment="viewStart"
                        android:gravity="start|center_vertical"
                        android:layoutDirection="rtl" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radioLocation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/location_rule"
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:buttonTint="@color/accent_color"
                        android:padding="12dp"
                        android:background="@drawable/radio_button_background"
                        android:layout_marginEnd="8dp"
                        android:textAlignment="viewStart"
                        android:gravity="start|center_vertical"
                        android:layoutDirection="rtl" />

                </RadioGroup>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Time Fields Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/timeFieldsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_background"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/timeFieldsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:layoutDirection="rtl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_settings_label"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_marginBottom="16dp"
                    android:textAlignment="viewStart"
                    android:gravity="start" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_days_label"
                    android:textSize="14sp"
                    android:textColor="@color/secondary_text"
                    android:layout_marginBottom="12dp"
                    android:textAlignment="viewStart"
                    android:gravity="start" />

                <com.yonatanh_tald_evem.smartsilence.views.WeekDaysView
                    android:id="@+id/weekDaysView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:layoutDirection="rtl" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layoutDirection="rtl">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTimeStart"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="@string/start_time_button"
                        android:textSize="14sp"
                        android:layout_marginStart="8dp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_schedule"
                        app:iconGravity="textEnd"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTimeEnd"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="@string/end_time_button"
                        android:textSize="14sp"
                        android:layout_marginEnd="8dp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_schedule"
                        app:iconGravity="textEnd"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Location Fields Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/locationFieldsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_background"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/locationFieldsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:layoutDirection="rtl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/location_settings_label"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_marginBottom="16dp"
                    android:textAlignment="viewStart"
                    android:gravity="start" />

                <TextView
                    android:id="@+id/labelLocationName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_location_label"
                    android:textSize="16sp"
                    android:textColor="@color/primary_text"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp"
                    android:textAlignment="viewStart"

                    android:drawablePadding="12dp"
                    android:minHeight="56dp"
/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="16dp">

                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/mapFragment"
                        android:name="com.google.android.gms.maps.SupportMapFragment"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tap_map_instruction"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:layout_marginBottom="16dp"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical|start"
                    android:textAlignment="viewStart"
                    app:drawableStartCompat="@drawable/ic_info" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/radius_hint"
                    app:boxStrokeColor="@color/accent_color"
                    app:hintTextColor="@color/accent_color"
                    app:suffixText="@string/radius_suffix"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputRadius"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="@string/one_hundred_number"
                        android:textColor="@color/primary_text"
                        android:textAlignment="viewStart"
                        android:gravity="start" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveRule"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/save_rule_button"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_save"
            app:iconGravity="textEnd"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

</ScrollView>